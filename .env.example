# Rutas y modo local
ARTEL_BI_PROJECT_PATH=C:\\ruta\\al\\proyecto_power_bi
ARTEL_ALLOW_WRITES=false

# Microsoft Entra - aplicación pública registrada por TI para Device Code Flow
# No guardar client secret: esta ruta usa PublicClientApplication.
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=

# Microsoft Fabric REST API
FABRIC_ACCESS_TOKEN=
FABRIC_API_BASE_URL=https://api.fabric.microsoft.com/v1
FABRIC_SCOPES=https://api.fabric.microsoft.com/Workspace.Read.All https://api.fabric.microsoft.com/Item.Read.All

# Power BI ExecuteQueries
POWERBI_ACCESS_TOKEN=
POWERBI_API_BASE_URL=https://api.powerbi.com/v1.0/myorg
POWERBI_DATASET_ID=
POWERBI_SCOPES=https://analysis.windows.net/powerbi/api/Dataset.Read.All

# Power Platform: endpoint aprobado por TI. Los scopes dependen de la API concreta.
POWERPLATFORM_ACCESS_TOKEN=
POWERPLATFORM_API_BASE_URL=
POWERPLATFORM_SCOPES=
